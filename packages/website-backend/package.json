{
  "name": "@stryker-mutator/dashboard-backend",
  "version": "0.20.7",
  "description": "The package which contains the stryker dashboard website backend.",
  "type": "module",
  "bin": {
    "dashboard-backend": "bin/dashboard-backend.js",
    "dashboard-healthcheck": "bin/healthcheck.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "node --enable-source-maps dist/index.js",
    "dev": "node --conditions=development --watch --enable-source-maps dist/index.js",
    "test": "c8 --check-coverage --reporter=html --report-dir=reports/coverage --lines 80 --functions 75 --branches 61 mocha --node-option enable-source-maps \"dist/test/**/*.js\"",
    "stryker": "stryker run"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stryker-mutator/stryker-dashboard.git",
    "directory": "packages/website-backend"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/serve-static": "12.0.0",
    "@stryker-mutator/dashboard-common": "workspace:*",
    "@stryker-mutator/dashboard-contract": "workspace:*",
    "@stryker-mutator/dashboard-data-access": "workspace:*",
    "@stryker-mutator/dashboard-frontend": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "applicationinsights": "3.16.0",
    "compression": "1.8.1",
    "cookie-session": "2.1.1",
    "helmet": "8.3.0",
    "openid-client": "6.8.7",
    "workerpool": "10.0.3"
  },
  "devDependencies": {
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@types/compression": "1.8.1",
    "@types/cookie-session": "2.0.49",
    "@types/express": "5.0.6",
    "@types/passport": "1.0.17",
    "@types/superagent": "8.1.11",
    "@types/supertest": "7.2.1",
    "mutation-testing-report-schema": "3.9.0",
    "supertest": "7.2.2"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0"
}
